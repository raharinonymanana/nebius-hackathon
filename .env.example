# Copy to .env (gitignored) and fill in. Never commit real values.

# Nebius Token Factory API key: Nemotron calls (prover/agent_v4.py) and ConTree sandboxes.
NEBIUS_API_KEY=
# Nebius project id: read by the ConTree SDK for sandbox calls.
NEBIUS_PROJECT_ID=
# Tavily API key: CVE advisory lookup (prover/advisory.py). Context only, never a verdict input.
TAVILY_API_KEY=
