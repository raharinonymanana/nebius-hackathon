# secrets and local env
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/

# local tooling
.claude/

# Run outputs. Top-level receipts/*.json ARE the eval dataset and are committed:
# `python -m prover.eval_report` re-scores them offline, model-free.
# Live-suite summaries (receipts/suites/) and any other run output stay local.
receipts/*
!receipts/*.json
receipts/suites/

# AWS SAM deploy artifacts
.aws-sam/
samconfig.toml

# compiled React UI copied from frontend/dist (sam ships it from the filesystem)
demo/web/

# build identity, regenerated per deploy by `python -m demo.build_info`
demo/build_info.json

# private design workspace (handoff drafts), not part of the build
design/
